# Copy to .env (git-ignored) and fill in the placeholders. Never commit real values.

# The API connects as the cohort_api login role, which holds no privileges of its own, through the
# Supabase Session pooler. The pooler's user is the role, a dot, then the project ref. The host is
# in Dashboard > Connect. Percent-encode any of @ : / ? # % in the password.
DATABASE_URL=postgresql://cohort_api.gejismdqvjuygtxibdhs:<cohort_api password>@<session pooler host>:5432/postgres

# The Supabase project whose access tokens the API accepts. Its signing keys are read from
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json.
SUPABASE_URL=https://gejismdqvjuygtxibdhs.supabase.co

# AI providers. Keep these server-side; never add them to apps/web/.env or VITE_ variables.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash

# The web app's origin, for CORS.
CORS_ORIGIN=http://localhost:5173
PORT=3000
HOST=127.0.0.1
